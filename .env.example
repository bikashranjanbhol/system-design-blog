# SQLite file used for local development
DATABASE_URL=file:./sd-blog.db
# Any long random string; keep it private
PAYLOAD_SECRET=replace-with-a-long-random-string
# Shown in the header and footer
NEXT_PUBLIC_SITE_NAME=System Design Notes
# Public address of the site, used in the RSS feed
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in (optional). Create an OAuth client in Google Cloud and register
# <site address>/auth/google/callback as its redirect address.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google addresses allowed to sign in to /admin. Leave empty to keep admin Google sign-in off.
GOOGLE_ADMIN_EMAILS=
